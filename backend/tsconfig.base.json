{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "allowJs": false,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  }
}
