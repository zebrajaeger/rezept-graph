{
  "llm": {
    "baseUrl": "http://localhost:1234/v1",
    "baseUrlEnv": "OPENAI_BASE_URL",
    "model": "local-model",
    "apiKeyEnv": "OPENAI_API_KEY",
    "timeoutMs": 60000
  },
  "cache": {
    "directory": "backend/.cache/recipe-pages",
    "mode": "cache-first"
  },
  "icons": {
    "mode": "generate-missing",
    "libraryDirectory": "assets/recipe-icons",
    "displayCacheDirectory": "backend/.cache/recipe-icons",
    "reportPath": "backend/outputs/icon-demand.json",
    "generator": {
      "backend": "codex-cli",
      "executable": "C:/replace-with-installed-native-codex/codex.exe",
      "termsReference": "https://openai.com/policies/terms-of-use/",
      "timeoutMs": 120000,
      "maxOutputBytes": 262144
    }
  },
  "output": {
    "directory": "backend/outputs",
    "includeIntermediateStates": true
  }
}
